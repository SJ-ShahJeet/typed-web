# --- Python (compiler/) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
compiler/dist/
compiler/build/

# --- Node (runtime/) ---
node_modules/
runtime/dist/
runtime/coverage/
runtime/web.d.ts          # generated by `npm run types`
npm-debug.log*
*.tsbuildinfo

# --- Runtime data (never commit a local index) ---
runtime/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# --- Playwright ---
test-results/
playwright-report/
.playwright-mcp/

# --- Compiler scratch (snapshots that ARE part of the registry live in specs/<site>/ and are committed) ---
compiler/.scratch/
*.har

# --- Secrets and local config ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Editors and OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
