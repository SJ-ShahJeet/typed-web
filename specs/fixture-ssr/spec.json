{
  "site": "fixture-ssr",
  "version": 1,
  "type": "Product",
  "access": "open",
  "locale": {
    "lang": "en-GB",
    "currency": "GBP",
    "dateOrder": "DMY"
  },
  "fetch": {
    "url": "http://127.0.0.1:8787/ssr/{id}.html",
    "method": "GET",
    "headers": {
      "accept": "text/html"
    },
    "auth": "none",
    "fetcher": "http"
  },
  "fields": {
    "title": {
      "type": "string",
      "required": true,
      "sources": [
        {
          "kind": "css",
          "selector": "main.product h1.title",
          "all": false
        }
      ]
    },
    "price": {
      "type": "money",
      "required": true,
      "sources": [
        {
          "kind": "css",
          "selector": "main.product span.price",
          "all": false
        }
      ]
    },
    "inStock": {
      "type": "enum",
      "required": true,
      "sources": [
        {
          "kind": "css",
          "selector": "main.product p.availability",
          "all": false
        }
      ],
      "coerce": "availability",
      "values": [
        "in_stock",
        "out_of_stock",
        "unknown"
      ]
    }
  },
  "freshness": {
    "defaultMaxAge": "1h"
  },
  "verify": {
    "samplePaths": [
      "2",
      "3"
    ]
  }
}
