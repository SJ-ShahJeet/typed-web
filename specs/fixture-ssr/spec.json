{
  "site": "fixture-ssr",
  "version": 1,
  "type": "Product",
  "access": "open",
  "locale": { "lang": "en-GB", "currency": "GBP", "dateOrder": "DMY" },
  "fetch": {
    "url": "http://127.0.0.1:8787/ssr/{id}.html",
    "method": "GET",
    "headers": { "accept": "text/html" },
    "auth": "none",
    "fetcher": "http"
  },
  "fields": {
    "title": {
      "type": "string",
      "sources": [
        { "kind": "css", "selector": "main.product h1.title" },
        { "kind": "css", "selector": "h1" }
      ]
    },
    "price": {
      "type": "money",
      "range": { "min": 1, "max": 10000 },
      "sources": [{ "kind": "css", "selector": "main.product span.price" }]
    },
    "inStock": {
      "type": "enum",
      "values": ["in_stock", "out_of_stock", "unknown"],
      "coerce": "availability",
      "sources": [{ "kind": "css", "selector": "main.product p.availability" }]
    }
  },
  "freshness": { "defaultMaxAge": "1h" },
  "verify": { "samplePaths": ["2", "3"] }
}
