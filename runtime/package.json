  "description": "Run Typed Web extractor specs with no model: fetch, extract, coerce, validate, index.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "main": "./src/web.ts",
